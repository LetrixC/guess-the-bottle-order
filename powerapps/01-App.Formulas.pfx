// =====================================================================
//  GUESS THE BOTTLE ORDER  ·  9 DOTS CONSULTING  (8-bit Power Apps mini game)
//  Paste this whole file into:  Tree view > App > Formulas
// =====================================================================

// ---- 9Dots palette: blue / white / black --------------------------------
C_Blue   = ColorValue("#1E4DFF");
C_BlueLt = ColorValue("#7A95FF");
C_Navy   = ColorValue("#0B1440");
C_Black  = ColorValue("#050505");
C_White  = ColorValue("#FFFFFF");
C_Dim    = ColorValue("#2A3670");
C_Gold   = ColorValue("#FFD60A");

// ---- Game rules ---------------------------------------------------------
// 4 hidden slots, 6 bottle colours, no repeated colours, 10 turns max.
MaxTurns = 10;

// The published app's web link (Details > Web link).
AppPlayLink = "https://apps.powerapps.com/play/e/d5f34760-038a-e270-9270-cebaa2210597/a/2fdc5afc-f29b-4ba0-81a0-d39920e94a09";

Bottles = Table(
    {Id: 1, Name: "RED",    Hex: "#E8303A"},
    {Id: 2, Name: "YELLOW", Hex: "#FFD60A"},
    {Id: 3, Name: "GREEN",  Hex: "#2EC45A"},
    {Id: 4, Name: "PURPLE", Hex: "#9B4DFF"},
    {Id: 5, Name: "ORANGE", Hex: "#FF8A1F"},
    {Id: 6, Name: "PINK",   Hex: "#FF5CB8"}
);

// ---- 8-bit pixel art (SVG, 12 x 22 grid) --------------------------------
SvgHead = "data:image/svg+xml;utf8,";

// One pixel bottle. "#FILL" is swapped for the bottle colour.
BottleRects =
    // black outline
    "<rect x='4' y='0' width='4' height='3' fill='#050505'/>" &
    "<rect x='4' y='3' width='4' height='5' fill='#050505'/>" &
    "<rect x='2' y='7' width='8' height='2' fill='#050505'/>" &
    "<rect x='1' y='9' width='10' height='12' fill='#050505'/>" &
    "<rect x='2' y='21' width='8' height='1' fill='#050505'/>" &
    // cap shine
    "<rect x='5' y='1' width='2' height='1' fill='#FFFFFF'/>" &
    // glass colour
    "<rect x='5' y='3' width='2' height='6' fill='#FILL'/>" &
    "<rect x='3' y='8' width='6' height='1' fill='#FILL'/>" &
    "<rect x='2' y='9' width='8' height='12' fill='#FILL'/>" &
    // label band, shine, shadow
    "<rect x='2' y='15' width='8' height='2' fill='#FFFFFF'/>" &
    "<rect x='3' y='10' width='1' height='4' fill='#FFFFFF' fill-opacity='0.75'/>" &
    "<rect x='8' y='9' width='1' height='12' fill='#000000' fill-opacity='0.3'/>";

BottleSvgOpen = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 22' shape-rendering='crispEdges'>";

BottleImg = AddColumns(
    Bottles,
    Img,
    SvgHead & EncodeUrl(BottleSvgOpen & Substitute(BottleRects, "#FILL", Hex) & "</svg>")
);

// Ghost bottle for an empty slot
EmptyBottle = SvgHead & EncodeUrl(
    BottleSvgOpen &
    Substitute(Substitute(BottleRects, "#FILL", "#1A2558"), "#FFFFFF", "#2A3670") &
    "</svg>"
);

// All six bottles in a row (title-screen decoration)
BottleParade = SvgHead & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 22' shape-rendering='crispEdges'>" &
    Concat(Bottles, "<g transform='translate(" & ((Id - 1) * 14) & ",0)'>" & Substitute(BottleRects, "#FILL", Hex) & "</g>") &
    "</svg>"
);

// 9 Dots Consulting round logo (200 x 200): navy ring, name, 9 growing dots
NineDotsRects =
    "<circle cx='100' cy='100' r='95' fill='#FFFFFF' stroke='#1F4E86' stroke-width='7'/>" &
    "<text x='100' y='98' text-anchor='middle' textLength='168' lengthAdjust='spacingAndGlyphs' " &
    "font-family='Georgia,Times New Roman,serif' font-size='21' fill='#111111'>" &
    "9 D<tspan font-size='16'>OTS</tspan> C<tspan font-size='16'>ONSULTING</tspan></text>" &
    Concat(
        Table(
            {x: 24.5,  r: 4,   c: "#D5DEEA"}, {x: 37,    r: 4.5, c: "#C3D0E2"},
            {x: 50.5,  r: 5,   c: "#ADC0D9"}, {x: 65,    r: 5.5, c: "#93ACCD"},
            {x: 81,    r: 6.5, c: "#7896BE"}, {x: 99,    r: 7.5, c: "#5E80B0"},
            {x: 119,   r: 8.5, c: "#4569A0"}, {x: 141.5, r: 10,  c: "#2D5491"},
            {x: 167.5, r: 12,  c: "#0F4C8A"}
        ),
        "<ellipse cx='" & x & "' cy='123' rx='" & r & "' ry='" & (r * 0.72) & "' fill='" & c & "'/>"
    );

NineDotsLogo = SvgHead & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'>" &
    NineDotsRects & "</svg>"
);

// Black background with a faint blue pixel-dot grid
BgPattern = SvgHead & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' width='1366' height='768' shape-rendering='crispEdges'>" &
    "<defs><pattern id='p' width='24' height='24' patternUnits='userSpaceOnUse'>" &
    "<rect width='24' height='24' fill='#050505'/><rect x='10' y='10' width='4' height='4' fill='#13235F'/>" &
    "</pattern></defs><rect width='1366' height='768' fill='url(#p)'/></svg>"
);
